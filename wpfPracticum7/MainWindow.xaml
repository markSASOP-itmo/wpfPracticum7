<Window x:Class="wpfPracticum7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpfPracticum7"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.CommandBindings>
        <CommandBinding Command="local:myComands.Exit" Executed="exExit" />
        <CommandBinding Command="Save" Executed="exSave" />
        <CommandBinding Command="Open" Executed="exOpen" />
    </Window.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height= "AUTO"/>
            <RowDefinition Height= "50"/>
            <RowDefinition Height ="AUTO"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Menu>
            <MenuItem Header="File">
                <MenuItem Header="Open"  Command="Open"/>
                <MenuItem Header="Save"  Command="Save"/>
                <MenuItem Header="Exit"  Command="local:myComands.Exit"/>
            </MenuItem>
            <MenuItem Header="View">
                <RadioButton Content="Light theme" IsChecked="True" Checked="changeToLightTheme"/>
                <RadioButton Content="Dark theme" Checked="RadioButton_Checked_3" />
            </MenuItem>
        </Menu>
        <ToolBarTray Grid.Row="1">
            <ToolBar>
                <Separator/>
                <ComboBox x:Name ="fontFamilies"  IsEditable="True" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0" SelectedIndex="0" Height="30" Width="150" FontSize="16"  ItemsSource="{StaticResource fonts}">
                   
                </ComboBox>
                <Separator/>
                <ComboBox Name ="fontSizes"  IsEditable="True" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="05,0,0,0" SelectedIndex="0" Height="30"  ItemsSource="{StaticResource sizes}">
                   
                </ComboBox>
            </ToolBar>
            <ToolBar Margin="20,0,0,0">
                <Button Width="35" Height="35" Click="Button_Click" FontWeight="Bold">
                    <Image Source="C:\Users\User\source\repos\wpfPracticum7\wpfPracticum7\fff/fatFont.png"/>
                </Button>
                <Separator/>
                <Button Width="35" Height="35" FontStyle="Italic" Click="Button_Click_1">
                    <Image Source="C:\Users\User\source\repos\wpfPracticum7\wpfPracticum7\fff\cursivFont.png"/>
                </Button>
                <Separator/>
                <Button Width="35" Height="35" Click="Button_Click_2" >
                    <Image Source="C:\Users\User\source\repos\wpfPracticum7\wpfPracticum7\fff\underlinedFont.png"/>
                </Button>
                <TextBlock x:Name="normalSettings"  Visibility="Collapsed" FontStyle="Normal" FontWeight="Normal" TextDecorations="Underline" />
                <TextBlock x:Name="normalSettings1"  Visibility="Collapsed" FontStyle="Normal" FontWeight="Normal" TextDecorations="None" />
                <Separator/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height= "AUTO"/>
                        <RowDefinition Height= "AUTO"/>
                    </Grid.RowDefinitions>
                    <Label Content="Цвет текста" HorizontalAlignment="Center"/>
                    <ToolBar Grid.Row="1">
                        <RadioButton Content="Чёрный" IsChecked="True" Foreground="Black" Checked="RadioButton_Checked"/>
                        <RadioButton Content="Красный" Foreground="Red" Checked="RadioButton_Checked_1"/>
                        <RadioButton Content="Синий" Foreground="Blue" Checked="RadioButton_Checked_2"/>

                    </ToolBar>
                </Grid>
            </ToolBar>
        </ToolBarTray>
        <GridSplitter Grid.Row="2" Height="5"/>
        <TextBox x:Name="textBox0" Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="{Binding ElementName=fontSizes, Path=SelectedItem}" FontFamily="{Binding ElementName=fontFamilies, Path=SelectedItem}" FontWeight="Normal" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
